# ============ Authentication (Required) ============
# Admin credentials for first deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-run

# JWT secret for signing authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret

# OpenAI-compatible runtime API key used by onprem/CleviFin.
# Generate with: openssl rand -base64 32
RUNTIME_API_KEY=replace-with-a-long-random-runtime-key

# Service token used by onprem to list/export saved cloned voices.
# Keep this distinct from user login JWTs.
TTS_LAB_SERVICE_TOKEN=replace-with-a-long-random-service-token
TTS_LAB_SERVICE_TOKEN_NAME=default-export

# Backward-compatible alias accepted by older onprem deployments.
# Prefer TTS_LAB_SERVICE_TOKEN for new deployments.
# TTS_LAB_ADMIN_TOKEN=replace-with-a-long-random-service-token

# CORS - comma-separated list of allowed origins (leave empty for localhost-only)
# Example: https://your-domain.com,https://another.com
ALLOWED_ORIGINS=

# ============ Model Configuration ============
QWEN_AUDIO_BACKEND=auto
QWEN_AUDIO_DEVICE=auto
# Optional overrides for low-latency GPU layouts. If unset, both use QWEN_AUDIO_DEVICE.
QWEN_TTS_DEVICE=auto
QWEN_ASR_DEVICE=auto
# Set to true only if a provider version requires process-wide serialized audio inference.
QWEN_AUDIO_SERIALIZE_GLOBAL=false
QWEN_AUDIO_TORCH_DTYPE=auto
QWEN_AUDIO_ATTN_IMPLEMENTATION=auto

# Optional model overrides
# QWEN_TTS_CUSTOM_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# QWEN_TTS_DESIGN_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# QWEN_TTS_CLONE_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# QWEN_ASR_DEFAULT_MODEL_ID=Qwen/Qwen3-ASR-1.7B
# QWEN_ASR_COMPACT_MODEL_ID=Qwen/Qwen3-ASR-0.6B

# QWEN_ASR_MAX_INFERENCE_BATCH_SIZE=32
# QWEN_ASR_MAX_NEW_TOKENS=256

HOST=0.0.0.0
PORT=8001
